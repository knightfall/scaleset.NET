# Copy to .env and replace every placeholder. .env is ignored by Git.
SCALESET_IMAGE=scaleset-autoscaler:local
SCALESET_STATE_DIR=./state
SCALESET_UID=10001
SCALESET_GID=10001
DOCKER_GID=999
SCALESET_STOP_GRACE_PERIOD=10m
HEALTH_PORT=8080

SCALESET__Controller__Identity=scaleset-controller
SCALESET__ScaleSets__0__Key=linux-x64
SCALESET__ScaleSets__0__GithubUrl=https://github.com/OWNER/REPOSITORY
SCALESET__ScaleSets__0__Name=linux-x64
SCALESET__ScaleSets__0__Scaling__Policy=SpareCapacity
SCALESET__ScaleSets__0__Scaling__MinRunners=0
SCALESET__ScaleSets__0__Scaling__MaxRunners=10
SCALESET__ScaleSets__0__RunnerProfile__Image=ghcr.io/OWNER/runner@sha256:REPLACE_WITH_IMAGE_DIGEST
SCALESET__ScaleSets__0__RunnerProfile__Architecture=X64
SCALESET__ScaleSets__0__RunnerProfile__Cpu=1
SCALESET__ScaleSets__0__RunnerProfile__Memory=2048

GITHUB_TOKEN=REPLACE_WITH_A_REPOSITORY_OR_ORGANIZATION_PAT
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
