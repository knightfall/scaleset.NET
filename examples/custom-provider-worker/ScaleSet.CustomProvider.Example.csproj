<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <UseScaleSetProjectReferences Condition="Exists('$(MSBuildThisFileDirectory)../../src/ScaleSet.Hosting/ScaleSet.Hosting.csproj')">true</UseScaleSetProjectReferences>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers" Version="$(RoslynatorVersion)" PrivateAssets="all" IncludeAssets="analyzers" Condition="'$(RoslynatorVersion)' != ''" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseScaleSetProjectReferences)' == 'true'">
    <ProjectReference Include="../../src/ScaleSet.Hosting/ScaleSet.Hosting.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseScaleSetProjectReferences)' != 'true'">
    <PackageReference Include="Knightfall.ScaleSet.Hosting" Version="0.1.0-alpha.2" />
  </ItemGroup>
</Project>
